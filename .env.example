# ==============================================================================
# NEXUS Ops — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local development or
# containerized deployment.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration
# Default to SQLite for zero-setup local development and automated testing:
DATABASE_URL=sqlite:///./nexus_ops.db

# PostgreSQL Configuration (used when running with Docker Compose or Production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_dev_password
POSTGRES_DB=nexus_ops
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# AI Layer Configuration
LLM_PROVIDER=gemini
# Optional: Provide Google Gemini API Key.
# If omitted or empty, NEXUS Ops seamlessly falls back to the deterministic AI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Security & Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_LOG_LINES=50000
REDACTION_ENABLED=true
