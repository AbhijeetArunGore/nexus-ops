# NEXUS Ops Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# Default to SQLite for zero-setup local dev/test; use Postgres for docker/prod
DATABASE_URL=sqlite:///./nexus_ops.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_ops

# AI Layer
LLM_PROVIDER=gemini
# Set your Gemini API key (or leave blank to use the built-in deterministic fallback provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Security & Redaction Limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_LOG_LINES=50000
REDACTION_ENABLED=true
