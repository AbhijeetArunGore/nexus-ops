#!/bin/sh
# ==============================================================================
# NEXUS Ops — Native Git Pre-Commit Security Hook
# Prevents unencrypted secrets, tokens, or private keys from entering Git history.
# ==============================================================================

echo "[SECURITY CHECK] Scanning staged files for secrets with Gitleaks..."

# Determine gitleaks binary
GITLEAKS_CMD=""
if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS_CMD="gitleaks"
elif [ -f "C:/Users/abhis/AppData/Local/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe" ]; then
    GITLEAKS_CMD="C:/Users/abhis/AppData/Local/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe"
fi

if [ -n "$GITLEAKS_CMD" ]; then
    "$GITLEAKS_CMD" git --staged --verbose --redact
    EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
        echo ""
        echo "======================================================================"
        echo "[SECURITY ALERT] Gitleaks detected potential secrets in staged files!"
        echo "Commit has been blocked to protect repository security."
        echo "Please remove, rotate, or redact credentials before committing."
        echo "======================================================================"
        echo ""
        exit 1
    fi
else
    echo "[WARNING] Gitleaks executable not found. Skipping pre-commit secret scan."
fi

exit 0
